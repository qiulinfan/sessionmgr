{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sessionmgr.dev/schemas/manifest-v1.schema.json",
  "title": "Session Manager Run Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "title",
    "created_at",
    "created_by",
    "runtime",
    "relation",
    "workspaces",
    "sessions",
    "checkpoints",
    "objects",
    "security",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "object",
      "required": ["machine_id"],
      "properties": {
        "machine_id": {
          "type": "string",
          "pattern": "^machine:uuid:"
        }
      }
    },
    "runtime": {
      "type": "object"
    },
    "parent_run_id": {
      "type": "string"
    },
    "relation": {
      "enum": ["capture", "revision", "fork", "restore", "handoff"]
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1
    },
    "sessions": {
      "type": "array",
      "minItems": 1
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["digest", "media_type", "size", "encoding", "required"],
        "properties": {
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "encoding": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "security": {
      "type": "object"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
