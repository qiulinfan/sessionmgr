#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_dir=$(dirname -- "$script_dir")
tools_dir=$repository_dir/.tools
downloads_dir=$tools_dir/downloads
staging_dir=
partial_archive=

# shellcheck disable=SC1091
. "$script_dir/go-toolchain.env"
go_version=${GO_VERSION-}

host_os=$(uname -s)
host_arch=$(uname -m)

case $host_os/$host_arch in
    Linux/x86_64|Linux/amd64)
        go_os=linux
        go_arch=amd64
        expected_sha256=${GO_SHA256_LINUX_AMD64-}
        ;;
    Linux/aarch64|Linux/arm64)
        go_os=linux
        go_arch=arm64
        expected_sha256=${GO_SHA256_LINUX_ARM64-}
        ;;
    Darwin/x86_64|Darwin/amd64)
        go_os=darwin
        go_arch=amd64
        expected_sha256=${GO_SHA256_DARWIN_AMD64-}
        ;;
    Darwin/arm64|Darwin/aarch64)
        go_os=darwin
        go_arch=arm64
        expected_sha256=${GO_SHA256_DARWIN_ARM64-}
        ;;
    *)
        echo "sessionmgr: automatic Go bootstrap does not support $host_os/$host_arch; install Go 1.24 or newer manually" >&2
        exit 1
        ;;
esac

case $go_version in
    ''|*[!0-9.]*) echo "sessionmgr: GO_VERSION is missing or invalid in '$script_dir/go-toolchain.env'" >&2; exit 1 ;;
esac
case $expected_sha256 in
    *[!0-9a-f]*|'') echo "sessionmgr: SHA-256 setting for $go_os/$go_arch is missing or invalid in '$script_dir/go-toolchain.env'" >&2; exit 1 ;;
esac
if [ ${#expected_sha256} -ne 64 ]; then
    echo "sessionmgr: SHA-256 setting for $go_os/$go_arch must contain 64 hexadecimal characters" >&2
    exit 1
fi

go_root=$tools_dir/go/$go_os-$go_arch
go_executable=$go_root/bin/go
lock_dir=$tools_dir/.go-bootstrap-$go_os-$go_arch.lock

expected_go_available() {
    [ -x "$go_executable" ] || return 1
    reported_version=$("$go_executable" version 2>/dev/null || true)
    case $reported_version in
        "go version go$go_version $go_os/$go_arch") return 0 ;;
        *) return 1 ;;
    esac
}

if expected_go_available; then
    exit 0
fi

if [ -e "$go_root" ]; then
    echo "sessionmgr: existing portable Go at '$go_root' is incomplete or not Go $go_version for $go_os/$go_arch; remove only that directory and retry" >&2
    exit 1
fi

archive_name=go$go_version.$go_os-$go_arch.tar.gz
archive_path=$downloads_dir/$archive_name
download_url=https://go.dev/dl/$archive_name

mkdir -p "$downloads_dir"
if ! mkdir "$lock_dir" 2>/dev/null; then
    if expected_go_available; then
        exit 0
    fi
    lock_pid=
    if [ -f "$lock_dir/pid" ]; then
        lock_pid=$(sed -n '1p' "$lock_dir/pid" 2>/dev/null || true)
    fi
    case $lock_pid in
        *[!0-9]*|'') lock_pid= ;;
    esac
    if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
        echo "sessionmgr: another Go bootstrap is running for $go_os/$go_arch; wait for it to finish before retrying" >&2
        exit 1
    fi
    case $lock_dir in
        "$tools_dir"/.go-bootstrap-*.lock) rm -rf -- "$lock_dir" ;;
        *) echo "sessionmgr: refusing to clear unexpected bootstrap lock '$lock_dir'" >&2; exit 1 ;;
    esac
    if ! mkdir "$lock_dir" 2>/dev/null; then
        echo "sessionmgr: could not acquire Go bootstrap lock for $go_os/$go_arch" >&2
        exit 1
    fi
fi
printf '%s\n' "$$" > "$lock_dir/pid"

cleanup() {
    if [ -n "$partial_archive" ]; then
        rm -f -- "$partial_archive"
    fi
    case ${staging_dir:-} in
        "$tools_dir"/.go-bootstrap.*|"$tools_dir"/.go-bootstrap-*) rm -rf -- "$staging_dir" ;;
    esac
    rm -f -- "$lock_dir/pid"
    rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

for stale_staging in "$tools_dir"/.go-bootstrap-"$go_os"-"$go_arch".*; do
    [ -d "$stale_staging" ] || continue
    rm -rf -- "$stale_staging"
done

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        echo "sessionmgr: SHA-256 tool is required to verify the Go download" >&2
        return 1
    fi
}

if [ -f "$archive_path" ]; then
    actual_sha256=$(sha256_of "$archive_path")
    if [ "$actual_sha256" != "$expected_sha256" ]; then
        echo "sessionmgr: cached Go archive '$archive_path' failed SHA-256 verification; remove only that file and retry" >&2
        exit 1
    fi
else
    partial_archive=$archive_path.part.$$
    echo "sessionmgr: Go was not found; downloading Go $go_version for $go_os/$go_arch..."
    if command -v curl >/dev/null 2>&1; then
        curl -fL "$download_url" -o "$partial_archive"
    elif command -v wget >/dev/null 2>&1; then
        wget -O "$partial_archive" "$download_url"
    else
        echo "sessionmgr: curl or wget is required to download the portable Go toolchain" >&2
        exit 1
    fi
    actual_sha256=$(sha256_of "$partial_archive")
    if [ "$actual_sha256" != "$expected_sha256" ]; then
        echo "sessionmgr: downloaded Go archive failed SHA-256 verification" >&2
        exit 1
    fi
    mv "$partial_archive" "$archive_path"
    partial_archive=
fi

staging_dir=$(mktemp -d "$tools_dir/.go-bootstrap-$go_os-$go_arch.XXXXXX")
tar -xzf "$archive_path" -C "$staging_dir"
if [ ! -x "$staging_dir/go/bin/go" ]; then
    echo "sessionmgr: the verified Go archive did not contain go/bin/go" >&2
    exit 1
fi
if [ -e "$go_root" ]; then
    echo "sessionmgr: portable Go destination '$go_root' appeared during bootstrap; refusing to overwrite it" >&2
    exit 1
fi
mkdir -p "$tools_dir/go"
mv "$staging_dir/go" "$go_root"

if ! expected_go_available; then
    echo "sessionmgr: portable Go installation completed but version verification failed" >&2
    exit 1
fi

echo "sessionmgr: bootstrapped Go $go_version for $go_os/$go_arch at $go_root"
